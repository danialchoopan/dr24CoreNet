@page
@model IndexModel
@{
    ViewData["Title"] = "جستجوی پزشک";
}

<div class="container">
    <div id="bookingTimer" class="hidden bg-red-600 text-white p-4 rounded-xl mb-8 text-center font-bold shadow-lg animate-pulse">
        ⏳ زمان باقی‌مانده برای تکمیل رزرو: 10:00
    </div>

    <div class="mb-10 text-center">
        <h1 class="text-4xl mb-2">پلتفرم نوبت‌دهی dr24CoreNet</h1>
        <p class="text-muted">سریع‌ترین راه برای رزرو نوبت از بهترین متخصصین کشور</p>
    </div>

    <div class="card mb-12 shadow-lg">
        <form class="grid grid-cols-3 items-end">
            <div>
                <label class="text-sm font-bold block mb-2">نام پزشک یا تخصص</label>
                <input type="text" placeholder="مثلاً: قلب، پوست..." />
            </div>
            <div>
                <label class="text-sm font-bold block mb-2">شهر</label>
                <select>
                    <option>همه شهرها</option>
                    <option>تهران</option>
                    <option>اصفهان</option>
                </select>
            </div>
            <button type="button" class="btn btn-primary text-lg py-3">جستجو و فیلتر پیشرفته</button>
        </form>
    </div>

    <div class="grid grid-cols-3">
        <!-- Doctor Card 1 -->
        <div class="card card-hover">
            <div class="flex items-center gap-4 mb-6">
                <div style="width:64px; height:64px; border-radius:50%; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:900; color:var(--primary); border:2px solid var(--primary);">A</div>
                <div>
                    <h3 class="text-lg">دکتر علی احمدی</h3>
                    <p class="text-muted">فوق تخصص قلب و عروق</p>
                </div>
            </div>
            <div class="text-sm space-y-2 mb-6">
                <div class="flex justify-between border-b pb-2">
                    <span class="text-muted">کد نظام پزشکی:</span>
                    <span class="font-bold">۱۲۳۴۵</span>
                </div>
                <div class="flex justify-between border-b pb-2">
                    <span class="text-muted">موقعیت:</span>
                    <span class="font-bold">تهران، سعادت آباد</span>
                </div>
            </div>
            <div class="font-bold text-sm mb-3">نوبت‌های آزاد امروز:</div>
            <div class="grid grid-cols-3 gap-2">
                <button onclick="bookSlot(1)" class="btn btn-outline text-xs py-2">۰۹:۰۰</button>
                <button onclick="bookSlot(2)" class="btn btn-outline text-xs py-2">۰۹:۳۰</button>
                <button onclick="bookSlot(3)" class="btn btn-primary text-xs py-2">۱۰:۰۰</button>
            </div>
        </div>

        <!-- Doctor Card 2 -->
        <div class="card card-hover">
            <div class="flex items-center gap-4 mb-6">
                <div style="width:64px; height:64px; border-radius:50%; background:#fef2f2; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:900; color:#ef4444; border:2px solid #ef4444;">S</div>
                <div>
                    <h3 class="text-lg">دکتر سارا رضایی</h3>
                    <p class="text-muted">متخصص پوست و مو</p>
                </div>
            </div>
            <div class="text-sm space-y-2 mb-6">
                <div class="flex justify-between border-b pb-2">
                    <span class="text-muted">کد نظام پزشکی:</span>
                    <span class="font-bold">۵۴۳۲۱</span>
                </div>
                <div class="flex justify-between border-b pb-2">
                    <span class="text-muted">موقعیت:</span>
                    <span class="font-bold">اصفهان، خیابان آمادگاه</span>
                </div>
            </div>
            <div class="font-bold text-sm mb-3">نوبت‌های آزاد امروز:</div>
            <div class="grid grid-cols-3 gap-2">
                <button onclick="bookSlot(4)" class="btn btn-outline text-xs py-2">۱۶:۰۰</button>
                <button class="btn btn-outline text-xs py-2 opacity-50 cursor-not-allowed" disabled>رزرو شده</button>
                <button class="btn btn-outline text-xs py-2 opacity-50 cursor-not-allowed" disabled>رزرو شده</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function bookSlot(slotId) {
            if(!confirm('آیا مایل به رزرو موقت این نوبت هستید؟ (۱۰ دقیقه فرصت پرداخت)')) return;
            startBookingTimer(600);
        }

        function startBookingTimer(duration) {
            let timer = duration;
            const display = document.getElementById('bookingTimer');
            display.classList.remove('hidden');
            setInterval(() => {
                let m = Math.floor(timer / 60), s = timer % 60;
                display.innerText = `⏳ زمان باقی‌مانده برای تکمیل رزرو: ${m}:${s < 10 ? '0' : ''}${s}`;
                if (--timer < 0) location.reload();
            }, 1000);
        }
    </script>
}
