@page
@model dr24CoreNet.WebUI.Pages.IndexModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = lang == "fa" ? "صفحه اصلی" : "Home";
}

<div class="max-w-6xl mx-auto">
    <div class="bg-white p-8 rounded-xl shadow-sm mb-8 dark:bg-slate-800">
        <h2 class="text-2xl font-black text-slate-900 mb-6 @(lang == "fa" ? "text-right" : "text-left") dark:text-white">@Loc.Get("AdvancedSearch", lang)</h2>
        <div class="flex flex-col md:flex-row gap-4 items-end">
            <div class="flex-grow w-full">
                <label class="block text-xs font-bold text-slate-500 mb-2 @(lang == "fa" ? "text-right" : "text-left")">@Loc.Get("NameOrSpec", lang)</label>
                <input type="text" class="input-modern @(lang == "fa" ? "text-right" : "text-left")" placeholder="@(lang == "fa" ? "مثلاً: قلب و عروق" : "e.g. Cardiologist")">
            </div>
            <div class="w-full md:w-64">
                <label class="block text-xs font-bold text-slate-500 mb-2 @(lang == "fa" ? "text-right" : "text-left")">@Loc.Get("City", lang)</label>
                <select class="input-modern @(lang == "fa" ? "text-right" : "text-left")">
                    <option>@Loc.Get("AllCities", lang)</option>
                    <option>@Loc.Get("Tehran", lang)</option>
                    <option>@Loc.Get("Isfahan", lang)</option>
                </select>
            </div>
            <button class="btn-primary px-12 py-3 rounded-lg font-bold">@Loc.Get("SearchBtn", lang)</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var doctor in Model.FeaturedDoctors)
        {
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col dark:bg-slate-800 dark:border-slate-700">
                <div class="flex justify-between items-start mb-4">
                    <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-xl font-bold text-slate-400 dark:bg-slate-700">
                        @(doctor.Name.Contains("Ali") || doctor.Name.Contains("علی") ? "A" : "S")
                    </div>
                    <div class="@(lang == "fa" ? "text-right" : "text-left")">
                        <h3 class="text-xl font-black text-slate-900 dark:text-white">@doctor.Name</h3>
                        <p class="text-blue-600 font-bold">@doctor.Specialization?.Name</p>
                    </div>
                </div>
                <div class="@(lang == "fa" ? "text-right" : "text-left") text-sm text-slate-500 mb-6 dark:text-slate-400">
                    @Loc.Get("MedicalCouncil", lang): @doctor.MedicalCouncilCode | @doctor.City
                </div>
                <div class="flex gap-2">
                    @if (doctor.Name.Contains("سارا") || doctor.Name.Contains("Sara"))
                    {
                        <div class="flex-grow py-2 bg-slate-100 text-slate-400 rounded text-center text-xs font-bold dark:bg-slate-700">@Loc.Get("Reserved", lang)</div>
                    }
                    <div class="flex-grow py-2 border border-slate-200 rounded text-center text-xs font-bold dark:border-slate-600 dark:text-slate-300">۱۶:۴۵</div>
                    <div class="flex-grow py-2 border border-slate-200 rounded text-center text-xs font-bold dark:border-slate-600 dark:text-slate-300">۱۶:۰۰</div>
                    @if (doctor.Name.Contains("علی") || doctor.Name.Contains("Ali"))
                    {
                        <div class="flex-grow py-2 border border-slate-200 rounded text-center text-xs font-bold dark:border-slate-600 dark:text-slate-300">۱۱:۰۰</div>
                        <div class="flex-grow py-2 border border-slate-200 rounded text-center text-xs font-bold dark:border-slate-600 dark:text-slate-300">۱۰:۳۰</div>
                        <div class="flex-grow py-2 border border-slate-200 rounded text-center text-xs font-bold dark:border-slate-600 dark:text-slate-300">۱۰:۰۰</div>
                    }
                </div>
            </div>
        }
    </div>
</div>
