@page
@model IndexModel
@{
    ViewData["Title"] = "جستجوی پیشرفته پزشکان";
}

<div class="container">
    <div id="bookingTimer" class="hidden bg-red-600 text-white p-4 rounded-xl mb-8 text-center font-bold shadow-lg animate-pulse">
        ⏳ زمان باقی‌مانده برای تکمیل رزرو: 10:00
    </div>

    <div class="mb-12">
        <h1 class="text-3xl font-extrabold text-slate-900 mb-2">پلتفرم نوبت‌دهی dr24CoreNet</h1>
        <p class="text-slate-600">انتخاب هوشمند پزشک، رزرو نوبت در کمتر از یک دقیقه</p>
    </div>

    <div class="card p-8 rounded-xl shadow-lg border-slate-100 mb-12">
        <div class="flex items-center gap-4 mb-6">
            <svg class="w-6 h-6 text-primary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <h2 class="text-xl font-bold">جستجوی پیشرفته پزشکان</h2>
        </div>
        <form class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
            <div class="flex flex-col gap-2">
                <label class="text-sm font-medium text-slate-600">نام پزشک یا تخصص</label>
                <input type="text" placeholder="مثلاً: قلب و عروق، دندانپزشکی..." class="input-modern" />
            </div>
            <div class="flex flex-col gap-2">
                <label class="text-sm font-medium text-slate-600">فیلتر شهر</label>
                <select class="input-modern">
                    <option>همه شهرها</option>
                    <option>تهران</option>
                    <option>اصفهان</option>
                    <option>مشهد</option>
                </select>
            </div>
            <button type="button" class="btn btn-primary text-lg h-12 shadow-sm">جستجو و فیلتر پزشکان</button>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Doctor Card 1 -->
        <div class="card p-6 rounded-xl shadow-sm border-slate-100 hover:shadow-lg transition duration-300">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-20 h-20 rounded-full bg-slate-100 border-2 border-primary-blue flex items-center justify-center text-3xl font-extrabold text-primary-blue">A</div>
                <div class="flex flex-col">
                    <h3 class="text-xl font-bold text-slate-900">دکتر علی احمدی</h3>
                    <span class="text-primary-blue font-medium text-sm">فوق تخصص قلب و عروق</span>
                </div>
            </div>
            <div class="space-y-3 mb-8 border-b border-slate-100 pb-6">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">کد نظام پزشکی:</span>
                    <span class="font-bold text-slate-700">۱۲۳۴۵</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">محل فعالیت:</span>
                    <span class="font-bold text-slate-700">تهران، بیمارستان پارس</span>
                </div>
            </div>
            <div class="mb-4">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">نوبت‌های در دسترس امروز:</h4>
                <div class="grid grid-cols-3 gap-2">
                    <button onclick="bookSlot(1)" class="btn slot-token text-xs py-2">۰۹:۰۰</button>
                    <button onclick="bookSlot(2)" class="btn slot-token text-xs py-2">۰۹:۳۰</button>
                    <button onclick="bookSlot(3)" class="btn slot-token text-xs py-2">۱۰:۰۰</button>
                </div>
            </div>
        </div>

        <!-- Doctor Card 2 -->
        <div class="card p-6 rounded-xl shadow-sm border-slate-100 hover:shadow-lg transition duration-300">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-20 h-20 rounded-full bg-slate-100 border-2 border-red-500 flex items-center justify-center text-3xl font-extrabold text-red-500">S</div>
                <div class="flex flex-col">
                    <h3 class="text-xl font-bold text-slate-900">دکتر سارا رضایی</h3>
                    <span class="text-primary-blue font-medium text-sm">متخصص پوست و مو</span>
                </div>
            </div>
            <div class="space-y-3 mb-8 border-b border-slate-100 pb-6">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">کد نظام پزشکی:</span>
                    <span class="font-bold text-slate-700">۵۴۳۲۱</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">محل فعالیت:</span>
                    <span class="font-bold text-slate-700">اصفهان، مجتمع تخصصی سپاهان</span>
                </div>
            </div>
            <div class="mb-4">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">نوبت‌های در دسترس امروز:</h4>
                <div class="grid grid-cols-3 gap-2">
                    <button class="btn slot-booked text-xs py-2" disabled>رزرو شده</button>
                    <button onclick="bookSlot(5)" class="btn slot-token text-xs py-2">۱۶:۴۵</button>
                    <button class="btn slot-booked text-xs py-2" disabled>رزرو شده</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function bookSlot(slotId) {
            if(!confirm('آیا از رزرو موقت این نوبت اطمینان دارید؟ (۱۰ دقیقه فرصت برای پرداخت)')) return;
            startBookingTimer(600);
        }

        function startBookingTimer(duration) {
            let timer = duration;
            const display = document.getElementById('bookingTimer');
            display.classList.remove('hidden');
            const interval = setInterval(() => {
                let m = Math.floor(timer / 60), s = timer % 60;
                display.innerText = `⏳ زمان باقی‌مانده برای تکمیل رزرو: ${m}:${s < 10 ? '0' : ''}${s}`;
                if (--timer < 0) { clearInterval(interval); location.reload(); }
            }, 1000);
        }
    </script>
}
