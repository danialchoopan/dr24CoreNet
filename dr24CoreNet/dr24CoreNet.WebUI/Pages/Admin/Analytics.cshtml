@page
@model dr24CoreNet.WebUI.Pages.Admin.AnalyticsModel
@{
    ViewData["Title"] = "گزارشات و تحلیل‌های مالی";
}

<div class="container mt-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="font-bold text-2xl">داشبورد مانیتورینگ هوشمند dr24CoreNet</h1>
        <div class="flex gap-4">
            <select id="timeFilter" class="text-sm">
                <option value="7">۷ روز اخیر</option>
                <option value="30">۳۰ روز اخیر</option>
                <option value="90">۹۰ روز اخیر</option>
            </select>
            <div class="bg-card p-2 border rounded-lg text-sm">بروزرسانی لایو (AJAX)</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-card p-6 rounded-lg shadow-lg border text-center">
            <h3 class="text-sm opacity-70">درآمد کل (۳۰ روز اخیر)</h3>
            <p class="font-bold text-3xl text-primary mt-2">۱۴۲,۵۰۰,۰۰۰ ریال</p>
        </div>
        <div class="bg-card p-6 rounded-lg shadow-lg border text-center">
            <h3 class="text-sm opacity-70">رزروهای موفق امروز</h3>
            <p class="font-bold text-3xl text-primary mt-2">۱۸۴ نوبت</p>
        </div>
        <div class="bg-card p-6 rounded-lg shadow-lg border text-center">
            <h3 class="text-sm opacity-70">درصد نفوذ بازار</h3>
            <p class="font-bold text-3xl text-primary mt-2">۱۲.۵٪</p>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-6">
        <div class="bg-card p-6 rounded-lg shadow-lg border">
            <h2 class="font-bold text-lg mb-6">نمودار حجم تراکنش‌های کارمزد</h2>
            <canvas id="commissionChart" style="max-height: 400px;"></canvas>
        </div>
        <div class="bg-card p-6 rounded-lg shadow-lg border">
            <h2 class="font-bold text-lg mb-6">توزیع رزروها بر اساس تخصص</h2>
            <canvas id="specializationChart" style="max-height: 400px;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.min.js"></script>
    <script>
        // Simulated Dynamic Charting Logic (Enterprise standard with Chart.js)
        document.addEventListener('DOMContentLoaded', () => {
            // Check if Chart.js exists (simulated in sandbox)
            if (typeof Chart === 'undefined') {
                console.warn('Chart.js library is local but might not be fully loaded in sandbox. Rendering fallback UI.');
                return;
            }

            const ctx1 = document.getElementById('commissionChart').getContext('2d');
            new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: ['شنبه', 'یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنجشنبه', 'جمعه'],
                    datasets: [{
                        label: 'درآمد (میلیون ریال)',
                        data: [12, 19, 15, 25, 22, 30, 20],
                        borderColor: '#2563eb',
                        tension: 0.4,
                        fill: true,
                        backgroundColor: 'rgba(37, 99, 235, 0.1)'
                    }]
                }
            });

            const ctx2 = document.getElementById('specializationChart').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['عمومی', 'متخصص', 'فوق تخصص'],
                    datasets: [{
                        data: [45, 30, 25],
                        backgroundColor: ['#3b82f6', '#8b5cf6', '#f59e0b']
                    }]
                }
            });
        });
    </script>
}
