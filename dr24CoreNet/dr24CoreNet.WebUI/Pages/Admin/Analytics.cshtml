@page
@model dr24CoreNet.WebUI.Pages.Admin.AnalyticsModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("AnalyticsTitle", lang);
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-black text-slate-900 dark:text-white">@Loc.Get("AnalyticsTitle", lang)</h1>
        <div class="flex gap-2">
            <span class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-bold">@Loc.Get("October25", lang)</span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
            <p class="text-slate-500 text-sm font-bold mb-2">@Loc.Get("TotalVolume", lang)</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">۴,۸۵۰,۰۰۰,۰۰۰ @Loc.Get("Currency", lang)</h3>
            <p class="text-green-500 text-xs mt-2 font-bold">↑ ۱۲٪ @Loc.Get("GrowthRate", lang)</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
            <p class="text-slate-500 text-sm font-bold mb-2">@Loc.Get("PlatformCommission", lang)</p>
            <h3 class="text-2xl font-black text-blue-600">۷۲۷,۵۰۰,۰۰۰ @Loc.Get("Currency", lang)</h3>
            <p class="text-slate-400 text-xs mt-2">بر اساس مدل اینترپرایز</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
            <p class="text-slate-500 text-sm font-bold mb-2">@Loc.Get("ActiveAppointments", lang)</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">۱,۲۴۰</h3>
            <p class="text-blue-500 text-xs mt-2 font-bold">در ۲۴ ساعت گذشته</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
            <p class="text-slate-500 text-sm font-bold mb-2">پزشکان فعال</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">۸۵</h3>
            <p class="text-slate-400 text-xs mt-2">در ۷ تخصص مختلف</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden dark:bg-slate-800 dark:border-slate-700">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
            <h3 class="font-black text-slate-900 dark:text-white">@Loc.Get("RecentTransactions", lang)</h3>
            <button class="text-blue-600 text-sm font-bold">مشاهده همه</button>
        </div>
        <table class="w-full text-sm @(lang == "fa" ? "text-right" : "text-left")">
            <thead class="bg-slate-50 text-slate-500 dark:bg-slate-700/50 dark:text-slate-400">
                <tr>
                    <th class="p-4">شناسه</th>
                    <th class="p-4">پزشک / بیمار</th>
                    <th class="p-4">مبلغ</th>
                    <th class="p-4">وضعیت</th>
                    <th class="p-4">زمان</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach(var i in Enumerable.Range(1, 5))
                {
                    <tr class="dark:text-slate-300">
                        <td class="p-4 font-mono text-xs">TRX-@i@i@i</td>
                        <td class="p-4">
                            <div class="font-bold">دکتر علی احمدی</div>
                            <div class="text-xs text-slate-400">بیمار: مریم سادات</div>
                        </td>
                        <td class="p-4 font-bold">۱,۲۰۰,۰۰۰ @Loc.Get("Currency", lang)</td>
                        <td class="p-4"><span class="px-2 py-1 bg-green-50 text-green-600 rounded text-[10px] font-bold dark:bg-green-900/20">موفق</span></td>
                        <td class="p-4 text-slate-400 text-xs">۱۰ دقیقه پیش</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
