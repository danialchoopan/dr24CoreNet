@page
@model dr24CoreNet.WebUI.Pages.Admin.AnalyticsModel
@{
    ViewData["Title"] = "تحلیل داده‌های کلان";
}

<div class="container">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1>داشبورد تحلیل هوشمند</h1>
            <p class="text-muted">نظارت بر درآمدهای کارمزد و توزیع تخصصی نوبت‌ها</p>
        </div>
        <div class="flex gap-4">
            <select style="width: auto;">
                <option>۳۰ روز اخیر</option>
                <option>۹۰ روز اخیر</option>
            </select>
            <button class="btn btn-primary">بروزرسانی لایو</button>
        </div>
    </div>

    <div class="grid grid-cols-3 mb-8">
        <div class="card text-center">
            <div class="text-muted mb-1">درآمد ناخالص (تومان)</div>
            <div class="text-xl font-bold text-primary">۷۸,۴۰۰,۰۰۰</div>
        </div>
        <div class="card text-center">
            <div class="text-muted mb-1">تعداد رزرو موفق</div>
            <div class="text-xl font-bold text-primary">۱,۴۰۲</div>
        </div>
        <div class="card text-center">
            <div class="text-muted mb-1">نرخ لغو نوبت</div>
            <div class="text-xl font-bold text-primary" style="color: #e11d48;">۳.۲٪</div>
        </div>
    </div>

    <div class="grid grid-cols-2">
        <div class="card">
            <h2 class="mb-6">روند درآمد کارمزد</h2>
            <div style="height: 300px; display: flex; align-items: flex-end; justify-content: space-around; padding: 20px; background: var(--bg); border-radius: 1rem;">
                <div style="width: 30px; background: var(--primary); height: 40%; border-radius: 4px;"></div>
                <div style="width: 30px; background: var(--primary); height: 65%; border-radius: 4px;"></div>
                <div style="width: 30px; background: var(--primary); height: 50%; border-radius: 4px;"></div>
                <div style="width: 30px; background: var(--primary); height: 85%; border-radius: 4px;"></div>
                <div style="width: 30px; background: var(--primary); height: 70%; border-radius: 4px;"></div>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-6">توزیع تخصصی نوبت‌ها</h2>
            <div style="height: 300px; display: flex; align-items: center; justify-content: center; position: relative;">
                <div style="width: 180px; height: 180px; border-radius: 50%; background: conic-gradient(var(--primary) 0% 40%, #8b5cf6 40% 70%, #f59e0b 70% 100%);"></div>
                <div style="position: absolute; width: 100px; height: 100px; border-radius: 50%; background: var(--card-bg);"></div>
            </div>
            <div class="flex justify-center gap-4 mt-4 text-sm">
                <span class="flex items-center gap-1"><div style="width:10px; height:10px; background:var(--primary); border-radius:2px;"></div> عمومی</span>
                <span class="flex items-center gap-1"><div style="width:10px; height:10px; background:#8b5cf6; border-radius:2px;"></div> متخصص</span>
            </div>
        </div>
    </div>
</div>
