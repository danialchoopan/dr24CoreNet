@page
@model dr24CoreNet.WebUI.Pages.Admin.AnalyticsModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("AnalyticsTitle", lang);
}

<div class="max-w-7xl mx-auto px-4">
    <!-- Header Card -->
    <div class="bg-royal-gradient p-12 rounded-[3rem] shadow-2xl mb-12 text-white relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-6">
            <div>
                <h1 class="text-4xl font-black mb-4">@Loc.Get("AnalyticsTitle", lang)</h1>
                <p class="text-blue-300 font-bold flex items-center gap-2">
                    <span class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
                    Live Financial Infrastructure Monitoring
                </p>
            </div>
            <div class="flex gap-4">
                <div class="px-6 py-3 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 text-sm font-black">
                    @Loc.Get("October25", lang) - v2.4.0
                </div>
            </div>
        </div>
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl -mr-32 -mt-32"></div>
    </div>

    <!-- Metric Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        @{
            var stats = new[] {
                (Loc.Get("TotalVolume", lang), Model.Finances.TotalRevenue.ToString("N0"), "green", "↑ ۱۲٪ " + Loc.Get("GrowthRate", lang)),
                (Loc.Get("PlatformCommission", lang), Model.Finances.TotalCommission.ToString("N0"), "blue", "Tier: Enterprise (15%)"),
                (Loc.Get("ActiveAppointments", lang), Model.RecentAppointments.Count.ToString(), "indigo", "Live tracking"),
                ("پزشکان آنلاین", "۸۵", "emerald", "7 Specializations")
            };
        }

        @foreach (var (title, val, color, trend) in stats)
        {
            <div class="card-colorful p-8 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-@color-50 rounded-full -mr-12 -mt-12 transition-transform group-hover:scale-150 dark:bg-@color-900/10"></div>
                <div class="relative z-10">
                    <p class="text-slate-500 text-xs font-black uppercase tracking-widest mb-4">@title</p>
                    <h3 class="text-3xl font-black text-slate-900 dark:text-white mb-2">@val <span class="text-sm font-bold text-slate-400">@Loc.Get("Currency", lang)</span></h3>
                    <p class="text-@color-600 text-[10px] font-black uppercase tracking-tighter">@trend</p>
                </div>
            </div>
        }
    </div>

    <!-- Table Section -->
    <div class="card-colorful overflow-hidden border-none shadow-2xl">
        <div class="p-8 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-white dark:bg-slate-800">
            <h3 class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-3">
                <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
                @Loc.Get("RecentTransactions", lang)
            </h3>
            <button class="px-6 py-2 bg-slate-100 text-slate-600 rounded-xl text-xs font-black hover:bg-blue-600 hover:text-white transition dark:bg-slate-700 dark:text-slate-300">Export CSV</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm @(lang == "fa" ? "text-right" : "text-left")">
                <thead class="bg-slate-50 text-slate-500 font-black uppercase tracking-widest text-[10px] dark:bg-slate-900/50">
                    <tr>
                        <th class="p-6">Tx ID</th>
                        <th class="p-6">Entity / Counterparty</th>
                        <th class="p-6">Volume</th>
                        <th class="p-6">Engine Status</th>
                        <th class="p-6">Timestamp</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach(var apt in Model.RecentAppointments)
                    {
                        <tr class="hover:bg-slate-50/50 transition dark:hover:bg-slate-900/50">
                            <td class="p-6 font-mono text-xs font-bold text-blue-600">TRX-@apt.Id</td>
                            <td class="p-6">
                                <div class="font-black text-slate-900 dark:text-white">Appointment #@apt.Id</div>
                                <div class="text-[10px] text-slate-400 font-bold">Patient ID: @apt.PatientId</div>
                            </td>
                            <td class="p-6 font-black text-slate-900 dark:text-white">@apt.Fee.ToString("N0") <span class="text-[10px] text-slate-400">@Loc.Get("Currency", lang)</span></td>
                            <td class="p-6">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 rounded-full text-[10px] font-black dark:bg-emerald-900/20 dark:text-emerald-400">
                                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                                    COMMITTED
                                </span>
                            </td>
                            <td class="p-6 text-slate-500 font-bold text-xs">@apt.ReservedAt.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
