@page
@model dr24CoreNet.WebUI.Pages.Admin.AuditModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("AuditTitle", lang);
}

<div class="max-w-7xl mx-auto">
    <div class="bg-slate-900 text-white p-8 rounded-2xl mb-8 flex justify-between items-center shadow-xl">
        <div>
            <h1 class="text-3xl font-black mb-2 flex items-center gap-3">
                <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                @Loc.Get("AuditTitle", lang)
            </h1>
            <p class="text-slate-400 font-bold">سامانه پایش امنیت و ردیابی تراکنش‌های درمانی (HIPAA Compliant)</p>
        </div>
        <div class="text-left font-mono text-xs text-blue-400">
            Node: Enterprise-Core-01<br>
            Status: Active Monitoring
        </div>
    </div>

    <div class="space-y-4">
        @foreach(var i in Enumerable.Range(1, 6))
        {
            <div class="bg-white border-l-4 border-blue-600 p-6 rounded-r-xl shadow-sm flex justify-between items-center dark:bg-slate-800 dark:border-blue-500">
                <div class="flex gap-6 items-center">
                    <div class="text-xs font-bold text-slate-400">۱۴:۳۲:۰@i</div>
                    <div>
                        <div class="font-bold text-slate-900 dark:text-white">تغییر وضعیت اسلات نوبت #@i@i@i@i</div>
                        <div class="text-xs text-slate-500">توسط سیستم (DistributedLockService)</div>
                    </div>
                    <div class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-[10px] font-bold dark:bg-slate-700 dark:text-slate-300">
                        PessimisticLock_Acquired
                    </div>
                </div>
                <div class="flex gap-4 items-center">
                    <div class="text-[10px] font-mono bg-slate-50 p-2 rounded dark:bg-slate-900 dark:text-blue-400">
                        {"status": "Locked", "user": "Patient_42", "expire": 600}
                    </div>
                    <button class="text-blue-600 font-bold text-xs">جزئیات JSON</button>
                </div>
            </div>
        }
    </div>
</div>
