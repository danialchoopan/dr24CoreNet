@page
@model dr24CoreNet.WebUI.Pages.AdminAuditModel
@{
    ViewData["Title"] = "ردیابی امنیتی عملیات";
}

<div class="sidebar">
    <!-- Same sidebar as dashboard -->
    <div class="p-6 border-b">
        <h1 class="text-xl font-bold text-blue-600">dr24CoreNet</h1>
    </div>
    <nav class="p-4 space-y-2">
        <a href="/Admin/Dashboard" class="flex items-center gap-3 p-3 text-slate-600 hover:bg-slate-50 rounded-lg transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
            داشبورد کلی
        </a>
        <a href="/Admin/Audit" class="flex items-center gap-3 p-3 bg-blue-50 text-blue-700 rounded-lg font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            گزارشات Audit
        </a>
    </nav>
</div>

<div class="main-content">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900">گزارش حسابرسی امنیتی (Medical Audit Trail)</h1>
        <p class="text-sm text-slate-500">مشاهده تمامی تغییرات حساس در لایه دیتابیس مطابق با استانداردهای HIPAA</p>
    </div>

    <div class="card overflow-hidden">
        <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
            <div class="flex gap-2">
                <input type="text" placeholder="جستجو در لاگ‌ها..." class="input-modern text-xs py-2 w-64" />
                <select class="input-modern text-xs py-2">
                    <option>همه عملیات‌ها</option>
                    <option>BOOK_APPOINTMENT</option>
                    <option>ISSUE_PRESCRIPTION</option>
                </select>
            </div>
            <span class="text-[10px] font-bold text-slate-400">نمایش ۵۰ مورد آخر</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right text-xs">
                <thead class="bg-slate-50/50 text-slate-400 border-b">
                    <tr>
                        <th class="p-4 font-bold">زمان</th>
                        <th class="p-4 font-bold">کاربر</th>
                        <th class="p-4 font-bold">عملیات</th>
                        <th class="p-4 font-bold">موجودیت</th>
                        <th class="p-4 font-bold">شناسه</th>
                        <th class="p-4 font-bold">آدرس IP</th>
                        <th class="p-4 font-bold text-left">جزئیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach(var log in new[] {
                        new { Time = "۱۴:۳۰:۰۵", User = "P-1024", Action = "BOOK_APPOINTMENT", Entity = "Appointment", Id = "8520", IP = "192.168.1.45" },
                        new { Time = "۱۴:۲۸:۱۲", User = "D-502", Action = "ISSUE_PRESCRIPTION", Entity = "Prescription", Id = "4412", IP = "2.180.45.11" },
                        new { Time = "۱۴:۲۵:۰۰", User = "System", Action = "REFUND_APPOINTMENT", Entity = "Wallet", Id = "W-88", IP = "Internal" },
                        new { Time = "۱۴:۲۰:۵۵", User = "P-1024", Action = "VIEW_HISTORY", Entity = "PatientHistory", Id = "1024", IP = "192.168.1.45" }
                    })
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-4 font-mono text-slate-500">@log.Time</td>
                            <td class="p-4"><span class="font-bold">@log.User</span></td>
                            <td class="p-4">
                                <span class="px-2 py-1 rounded bg-blue-100 text-blue-700 font-bold text-[10px]">@log.Action</span>
                            </td>
                            <td class="p-4 text-slate-600">@log.Entity</td>
                            <td class="p-4 text-slate-400">#@log.Id</td>
                            <td class="p-4 text-slate-500">@log.IP</td>
                            <td class="p-4 text-left">
                                <button class="text-blue-600 hover:underline font-bold">مشاهده JSON</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
