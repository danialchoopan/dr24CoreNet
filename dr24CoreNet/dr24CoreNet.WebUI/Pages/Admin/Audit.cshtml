@page
@model dr24CoreNet.WebUI.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Audit Trail";
}

<div class="container">
    <div class="mb-6">
        <h1>گزارش نظارتی سیستم</h1>
        <p class="text-muted">پیگیری غیرقابل تغییر تمامی فعالیت‌های حساس در بستر HIPAA</p>
    </div>

    <div class="card">
        <div class="timeline">
            <!-- Entry 1 -->
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="card card-hover" style="padding: 1rem;">
                    <div class="flex justify-between items-center mb-2">
                        <span class="badge badge-blue">بروزرسانی نسخه</span>
                        <span class="text-muted" style="font-size: 0.75rem;">۱۰:۴۵ - ۱۴۰۲/۱۰/۱۲</span>
                    </div>
                    <p class="font-bold">تغییر در اقلام نسخه الکترونیک</p>
                    <div class="mt-2 text-sm">
                        <span class="text-muted">توسط:</span> دکتر علی احمدی (ID: 502)
                    </div>
                    <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-900 rounded-lg text-xs font-mono border">
                        "After": { "Drug": "Metformin", "Dosage": "500mg" }
                    </div>
                </div>
            </div>

            <!-- Entry 2 -->
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="card card-hover" style="padding: 1rem;">
                    <div class="flex justify-between items-center mb-2">
                        <span class="badge badge-red">دسترسی امنیتی</span>
                        <span class="text-muted" style="font-size: 0.75rem;">۰۹:۱۵ - ۱۴۰۲/۱۰/۱۲</span>
                    </div>
                    <p class="font-bold">مشاهده سوابق بیمار #۱۸۰۲</p>
                    <div class="mt-2 text-sm">
                        <span class="text-muted">IP:</span> 192.168.1.104 (Tehran, Iran)
                    </div>
                </div>
            </div>

            <!-- Entry 3 -->
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="card card-hover" style="padding: 1rem;">
                    <div class="flex justify-between items-center mb-2">
                        <span class="badge badge-blue">سیستم مالی</span>
                        <span class="text-muted" style="font-size: 0.75rem;">۰۸:۳۰ - ۱۴۰۲/۱۰/۱۲</span>
                    </div>
                    <p class="font-bold">بروزرسانی نرخ کارمزد تخصص</p>
                    <div class="text-sm mt-1">تغییر نرخ "فوق تخصص" از ۱۵٪ به ۲۰٪ توسط مدیر کل.</div>
                </div>
            </div>
        </div>
    </div>
</div>
