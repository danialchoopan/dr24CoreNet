@page "{id}"
@model dr24CoreNet.WebUI.Pages.ChatModel
@{
    ViewData["Title"] = "مشاوره آنلاین";
}

<div class="container">
    <div class="card mb-6" style="padding: 1rem;">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div style="width:12px; height:12px; border-radius:50%; background:#22c55e;"></div>
                <h2 style="font-size:1rem;">مشاوره فعال با دکتر علی احمدی</h2>
            </div>
            <span class="text-muted" style="font-size:0.75rem;">شناسه نوبت: #@RouteData.Values["id"]</span>
        </div>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="chat-window bg-slate-50 dark:bg-slate-900/50" id="chat">
            <div class="bubble bubble-in">سلام. خسته نباشید. چطور می‌تونم کمکتون کنم؟</div>
            <div class="bubble bubble-out">سلام آقای دکتر. بابت جواب آزمایش مزاحمتون شدم.</div>
            <div class="bubble bubble-in">خواهش می‌کنم. لطفاً فایل رو ارسال کنید یا مقادیر TSH رو بگید.</div>
        </div>

        <div class="p-4 border-t flex gap-4">
            <input type="text" placeholder="پیام خود را بنویسید..." id="msg" />
            <button class="btn btn-primary px-10" onclick="send()">ارسال</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function send() {
            const input = document.getElementById('msg');
            if(!input.value) return;
            const chat = document.getElementById('chat');
            const div = document.createElement('div');
            div.className = 'bubble bubble-out';
            div.innerText = input.value;
            chat.appendChild(div);
            input.value = '';
            chat.scrollTop = chat.scrollHeight;
        }
    </script>
}
