@page
@model dr24CoreNet.WebUI.Pages.ChatModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("ChatTitle", lang);
}

<div class="max-w-4xl mx-auto h-[700px] bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col border border-slate-100 dark:bg-slate-800 dark:border-slate-700">
    <div class="p-6 bg-blue-600 text-white flex justify-between items-center">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center font-bold">A</div>
            <div>
                <h3 class="font-black">دکتر علی احمدی</h3>
                <p class="text-xs text-blue-100">در حال گفتگو (Online)</p>
            </div>
        </div>
        <button class="px-4 py-2 bg-white/10 rounded-lg text-sm font-bold hover:bg-white/20">پایان گفتگو</button>
    </div>

    <div class="flex-grow p-8 space-y-6 overflow-y-auto bg-slate-50 dark:bg-slate-900/50">
        <div class="flex @(lang == "fa" ? "justify-start" : "justify-end")">
            <div class="max-w-[70%] bg-white p-4 rounded-2xl rounded-tr-none shadow-sm dark:bg-slate-800">
                <p class="text-sm dark:text-slate-300">سلام آقای دکتر، وقت بخیر. بابت نتایج آزمایش اخیر سوال داشتم.</p>
                <span class="text-[10px] text-slate-400 mt-2 block">۱۰:۴۵</span>
            </div>
        </div>

        <div class="flex @(lang == "fa" ? "justify-end" : "justify-start")">
            <div class="max-w-[70%] bg-blue-600 text-white p-4 rounded-2xl rounded-tl-none shadow-md">
                <p class="text-sm">سلام. بله بفرمایید. نتایج رو بررسی کردم، میزان کلسترول کمی بالاست.</p>
                <span class="text-[10px] text-blue-200 mt-2 block">۱۰:۴۷</span>
            </div>
        </div>

        <div class="flex @(lang == "fa" ? "justify-start" : "justify-end")">
            <div class="max-w-[70%] bg-white p-4 rounded-2xl rounded-tr-none shadow-sm dark:bg-slate-800">
                <p class="text-sm dark:text-slate-300">آیا نیازی به تغییر دوز داروها هست؟</p>
                <span class="text-[10px] text-slate-400 mt-2 block">۱۰:۴۸</span>
            </div>
        </div>
    </div>

    <div class="p-6 bg-white border-t border-slate-100 dark:bg-slate-800 dark:border-slate-700">
        <div class="flex gap-4">
            <input type="text" class="input-modern flex-grow" placeholder="پیام خود را بنویسید...">
            <button class="btn-primary px-8 rounded-xl font-bold">ارسال</button>
        </div>
    </div>
</div>
