@page
@model dr24CoreNet.WebUI.Pages.Doctor.AppointmentsModel
@{
    ViewData["Title"] = "مدیریت تقویم و نوبت‌ها";
}

<div class="main-content" style="margin-right: 0;">
    <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">پنل اختصاصی پزشک</h1>
                <p class="text-sm text-slate-500">مشاهده و مدیریت نوبت‌های رزرو شده و تنظیم ساعات کاری</p>
            </div>
            <button class="btn-primary flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"></path></svg>
                تعریف بازه زمانی جدید
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Calendar View Mockup -->
            <div class="lg:col-span-2">
                <div class="card p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="font-bold flex items-center gap-2">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            تقویم نوبت‌دهی (هفته جاری)
                        </h2>
                        <div class="flex gap-2">
                            <button class="p-2 border rounded-lg hover:bg-slate-50 transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"></path></svg></button>
                            <button class="p-2 border rounded-lg hover:bg-slate-50 transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg></button>
                        </div>
                    </div>

                    <div class="grid grid-cols-7 gap-2 text-center text-xs font-bold text-slate-400 mb-4">
                        <div>شبه</div><div>۱شبه</div><div>۲شبه</div><div>۳شبه</div><div>۴شبه</div><div>۵شبه</div><div>جمعه</div>
                    </div>

                    <div class="grid grid-cols-7 gap-2">
                        @for(int i = 1; i <= 31; i++) {
                            <div class="h-20 border rounded-lg p-2 text-[10px] @(i == 15 ? "bg-blue-50 border-blue-200" : "bg-white")">
                                <span class="font-bold @(i == 15 ? "text-blue-600" : "text-slate-400")">@i</span>
                                @if(i == 15) {
                                    <div class="mt-1 p-1 bg-blue-600 text-white rounded text-[8px] font-bold">۸ نوبت</div>
                                }
                                @if(i == 16) {
                                    <div class="mt-1 p-1 bg-green-500 text-white rounded text-[8px] font-bold">تکمیل</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Todays Appointments -->
            <div class="space-y-6">
                <div class="card p-6">
                    <h3 class="font-bold mb-4 text-sm">نوبت‌های اخیر</h3>
                    <div class="space-y-4">
                        @foreach(var apt in Model.TodaysAppointments)
                        {
                            <div class="p-3 bg-slate-50 rounded-lg flex justify-between items-center">
                                <div>
                                    <p class="text-xs font-bold text-slate-900">بیمار شناسه #@apt.PatientId</p>
                                    <p class="text-[10px] text-slate-500">@apt.ReservedAt.ToShortTimeString()</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-xs font-black text-blue-600">@apt.Fee.ToString("N0")</span>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="w-full mt-6 py-2 text-blue-600 text-xs font-bold border border-blue-100 rounded-lg hover:bg-blue-50 transition">مشاهده همه نوبت‌ها</button>
                </div>

                <div class="card p-6 bg-blue-600 text-white">
                    <h3 class="font-bold mb-2 text-sm">درآمد اخیر</h3>
                    <p class="text-2xl font-black">@Model.TodaysRevenue.ToString("N0") <span class="text-xs font-normal opacity-75">ریال</span></p>
                    <p class="mt-4 text-[10px] opacity-75">کارمزد کسر شده: @((Model.TodaysRevenue * 0.15m).ToString("N0")) ریال</p>
                </div>
            </div>
        </div>
    </div>
</div>
