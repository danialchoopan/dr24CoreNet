<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - dr24CoreNet</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <div class="container nav-content">
            <div class="flex items-center gap-8">
                <a asp-page="/Index" class="nav-link" style="font-size: 1.5rem; font-weight: 900; color: var(--primary);">dr24CoreNet</a>
                <div class="nav-links">
                    <a asp-page="/Index" class="nav-link">جستجوی پزشک</a>
                    <a asp-page="/Patient/History" class="nav-link">پرونده من</a>
                    <a asp-page="/Doctor/Dashboard" class="nav-link">پنل پزشک</a>
                    <a asp-page="/Admin/Analytics" class="nav-link">مدیریت کل</a>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <a asp-page="/Admin/Audit" class="nav-link text-sm">Audit Trail</a>
                <button onclick="toggleTheme()" class="btn btn-outline" style="padding: 0.5rem;">🌓</button>
            </div>
        </div>
    </nav>

    <main role="main" class="mt-8">
        @RenderBody()
    </main>

    <footer class="mt-8 py-8 border-t" style="background: var(--card-bg);">
        <div class="container text-center">
            <p class="text-muted">© ۲۰۲۴ پلتفرم نوبت‌دهی dr24CoreNet. تمامی حقوق محفوظ است.</p>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
