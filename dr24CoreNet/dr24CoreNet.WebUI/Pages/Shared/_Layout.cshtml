<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - dr24CoreNet</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <div class="container nav-content">
            <a asp-page="/Index" class="logo">dr24CoreNet</a>

            <div class="flex items-center gap-6">
                <div class="nav-links">
                    <a asp-page="/Index" class="nav-link">جستجوی پزشک</a>
                    <a asp-page="/Patient/History" class="nav-link">پرونده من</a>
                    <a asp-page="/Doctor/Dashboard" class="nav-link">پنل پزشک</a>
                    <a asp-page="/Admin/Analytics" class="nav-link">پنل مدیریت</a>
                </div>

                <div class="flex items-center gap-4 border-r pr-6 border-slate-200">
                    <button onclick="toggleTheme()" class="btn btn-slate" style="border-radius: 9999px; padding: 0.5rem;">🌓</button>
                    <div class="flex flex-col items-end">
                        <span class="text-xs font-bold text-slate-900">جواد کریمی</span>
                        <a href="#" class="text-xs text-red-500 hover:text-red-700 font-medium">خروج</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="mt-8 pb-12">
        @RenderBody()
    </main>

    <footer class="py-8 border-t bg-white dark:bg-slate-900">
        <div class="container text-center">
            <p class="text-xs text-slate-500">© ۲۰۲۶ - پلتفرم نوبت‌دهی dr24CoreNet - تمامی حقوق محفوظ است.</p>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
