<!DOCTYPE html>
@{
    string lang = Context.Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    string dir = lang == "fa" ? "rtl" : "ltr";
}
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - dr24CoreNet</title>
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Ensuring font priority */
        body { font-family: 'Vazirmatn', sans-serif !important; }
    </style>
</head>
<body class="bg-slate-50 transition-colors duration-300">
    <header class="bg-white border-b sticky top-0 z-50 dark:bg-slate-900 dark:border-slate-800">
        <div class="max-w-6xl mx-auto px-4 h-12 flex justify-between items-center">
            <div class="flex gap-6 text-xs font-bold">
                <a href="/Search?lang=@lang" class="text-blue-600 hover:underline">@Loc.Get("SearchDoctor", lang)</a>
                <a href="/Doctor/Appointments?lang=@lang" class="text-blue-600 hover:underline">@Loc.Get("DoctorPanel", lang)</a>
                <a href="/Admin/Dashboard?lang=@lang" class="text-blue-600 hover:underline">@Loc.Get("AdminPanel", lang)</a>
            </div>
            <a href="/?lang=@lang" class="text-sm font-black text-blue-600 tracking-tighter">dr24CoreNet</a>
        </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex justify-between items-start mb-8 bg-white p-8 rounded-xl shadow-sm dark:bg-slate-800">
            <button id="theme-toggle" class="border border-slate-300 px-3 py-1 rounded text-sm hover:bg-slate-50 transition dark:text-white dark:border-slate-600 dark:hover:bg-slate-700">
                @Loc.Get("ThemeToggle", lang)
            </button>
            <div class="@(lang == "fa" ? "text-left" : "text-right")">
                <h1 class="text-4xl font-black text-slate-900 dark:text-white">@Loc.Get("PlatformTitle", lang)</h1>
                <p class="text-slate-500 dark:text-slate-400">@Loc.Get("Slogan", lang)</p>
            </div>
        </div>
    </div>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-t bg-white py-12 mt-20 dark:bg-slate-900 dark:border-slate-800">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <p class="text-sm text-slate-400 font-bold uppercase tracking-widest mb-4">dr24CoreNet - پلتفرم نوبت‌دهی پزشکی</p>
            <div class="flex justify-center gap-8 mb-8 text-slate-500 text-xs font-bold">
                <a href="#">قوانین و مقررات</a>
                <a href="#">پشتیبانی</a>
                <a href="#">درباره ما</a>
                <a href="#">فرصت‌های شغلی</a>
            </div>
            <p class="text-[10px] text-slate-300">© ۱۴۰۲ تمامی حقوق برای پلتفرم dr24CoreNet محفوظ است. طراحی شده با Clean Architecture.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;

        themeToggle.addEventListener('click', () => {
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        });

        // Check for saved theme
        if (localStorage.getItem('theme') === 'dark') {
            html.classList.add('dark');
        }
    </script>
</body>
</html>
