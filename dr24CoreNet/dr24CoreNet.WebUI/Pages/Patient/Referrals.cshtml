@page
@model dr24CoreNet.WebUI.Pages.Patient.ReferralsModel
@{
    ViewData["Title"] = "ارجاعات و مشاوره‌های تخصصی";
}

<div class="container mt-4">
    <h1 class="text-2xl font-bold mb-6">سیستم هوشمند ارجاع dr24CoreNet</h1>

    <div class="bg-card p-6 rounded-lg shadow-lg border mb-8">
        <h2 class="font-bold text-lg mb-4">توکن‌های فعال ارجاع شما</h2>
        <div class="grid grid-cols-1 gap-4">
            <div class="border p-4 rounded-lg flex justify-between items-center bg-blue-50 dark:bg-blue-900/20">
                <div>
                    <p class="font-bold text-primary">کد ارجاع: REF-98X2P</p>
                    <p class="text-sm opacity-70">ارجاع شده از: دکتر علی احمدی</p>
                    <p class="text-sm opacity-70">پزشک مقصد: متخصص آنکولوژی (دکتر سارا رضایی)</p>
                </div>
                <div class="text-right">
                    <span class="bg-green-500 text-white px-3 py-1 rounded-full text-xs">معتبر تا ۱۵ روز دیگر</span>
                    <button class="block mt-2 bg-primary px-4 py-2 rounded-lg text-sm">رزرو با اولویت بالا</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-card p-6 rounded-lg shadow-lg border">
        <h2 class="font-bold text-lg mb-4">مزایای سیستم ارجاع</h2>
        <ul class="text-sm opacity-80 list-disc pr-6 space-y-2">
            <li>دسترسی به اسلات‌های اختصاصی پزشکان فوق تخصص.</li>
            <li>کاهش ۱۵ درصدی کارمزد نوبت برای بیماران ارجاعی.</li>
            <li>انتقال خودکار سوابق پزشکی و نسخه‌های قبلی به پزشک جدید.</li>
        </ul>
    </div>
</div>
