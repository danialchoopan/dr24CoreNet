@page
@model dr24CoreNet.WebUI.Pages.Patient.HistoryModel
@{
    ViewData["Title"] = "پرونده سلامت دیجیتال";
}

<div class="container">
    <div class="mb-10">
        <h1 class="text-3xl font-extrabold text-slate-900">پرونده سلامت دیجیتال dr24CoreNet</h1>
        <p class="text-slate-600 mt-1">مدیریت متمرکز نسخه‌ها، نوبت‌ها و تراکنش‌های مالی</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Panel 1: Recent Appointments & Prescriptions -->
        <div class="lg:col-span-2 space-y-6">
            <h2 class="text-xl font-bold flex items-center gap-2">
                <svg class="w-6 h-6 text-primary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                نوبت‌های اخیر و نسخه‌ها
            </h2>

            <div class="card overflow-hidden shadow-sm">
                <table class="w-full text-sm text-right border-collapse">
                    <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-100">
                        <tr>
                            <th class="p-4 font-bold text-slate-400">تاریخ</th>
                            <th class="p-4 font-bold text-slate-400">پزشک</th>
                            <th class="p-4 font-bold text-slate-400">تخصص</th>
                            <th class="p-4 font-bold text-slate-400">نسخه دیجیتال</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="p-4 font-medium">۱۴۰۲/۱۰/۱۰</td>
                            <td class="p-4">
                                <a href="#" class="text-primary-blue font-bold hover:underline">دکتر علی احمدی</a>
                            </td>
                            <td class="p-4 text-slate-500">فوق تخصص قلب</td>
                            <td class="p-4">
                                <div class="flex items-center gap-2 text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg border border-blue-100">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.628.285a2 2 0 01-1.963 0l-.628-.285a6 6 0 00-3.86-.517l-2.387.477a2 2 0 00-1.022.547V18a2 2 0 002 2h11a2 2 0 002-2v-2.572z"></path></svg>
                                    آزیترومایسین ۵۰۰ (۵ عدد)
                                </div>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="p-4 font-medium">۱۴۰۲/۰۹/۱۵</td>
                            <td class="p-4">
                                <a href="#" class="text-primary-blue font-bold hover:underline">دکتر سارا رضایی</a>
                            </td>
                            <td class="p-4 text-slate-500">متخصص پوست</td>
                            <td class="p-4">
                                <span class="text-slate-300 italic">فاقد نسخه</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Panel 2: Wallet Status & Payments -->
        <div class="space-y-6">
            <h2 class="text-xl font-bold flex items-center gap-2">
                <svg class="w-6 h-6 text-primary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                وضعیت کیف پول و پرداخت‌ها
            </h2>

            <div class="card p-8 bg-primary-blue text-white shadow-lg relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full"></div>
                <p class="text-xs font-bold uppercase tracking-widest opacity-80 mb-2">موجودی فعلی حساب</p>
                <div class="flex items-baseline gap-2">
                    <span class="text-4xl font-extrabold font-mono tracking-tighter">۷,۵۰۰,۰۰۰</span>
                    <span class="text-sm font-medium opacity-80">ریال</span>
                </div>
                <button class="btn bg-white text-primary-blue w-full mt-8 shadow-sm">+ افزایش موجودی</button>
            </div>

            <div class="card p-6 shadow-sm border-slate-100">
                <h3 class="text-xs font-bold text-slate-400 mb-6 uppercase tracking-wider">تراکنش‌های اخیر</h3>
                <div class="space-y-5">
                    <div class="flex justify-between items-start">
                        <div class="flex gap-3">
                            <div class="w-8 h-8 bg-red-50 text-red-500 rounded-full flex items-center justify-center">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold">رزرو نوبت - دکتر احمدی</p>
                                <p class="text-[10px] text-slate-400">۱۰ دی ۱۴۰۲ - ۱۱:۳۰</p>
                            </div>
                        </div>
                        <span class="text-sm font-extrabold text-red-500">-۲,۰۰۰,۰۰۰</span>
                    </div>
                    <div class="flex justify-between items-start">
                        <div class="flex gap-3">
                            <div class="w-8 h-8 bg-green-50 text-green-500 rounded-full flex items-center justify-center">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold">برگشت وجه (لغو نوبت)</p>
                                <p class="text-[10px] text-slate-400">۱۸ آذر ۱۴۰۲ - ۰۹:۱۵</p>
                            </div>
                        </div>
                        <span class="text-sm font-extrabold text-green-600">+۱,۵۰۰,۰۰۰</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
