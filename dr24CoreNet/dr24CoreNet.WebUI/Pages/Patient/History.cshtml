@page
@model dr24CoreNet.WebUI.Pages.Patient.HistoryModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("PatientHistory", lang);
}

<div class="max-w-5xl mx-auto">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 mb-8 dark:bg-slate-800 dark:border-slate-700">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">@Loc.Get("PatientHistory", lang)</h1>
            <button class="btn-primary px-6 py-2 rounded-lg text-sm">دریافت کل پرونده (PDF)</button>
        </div>

        <div class="space-y-8">
            <div class="relative @(lang == "fa" ? "pr-8 border-r-2" : "pl-8 border-l-2") border-blue-100 dark:border-slate-700">
                <div class="absolute w-4 h-4 bg-blue-600 rounded-full top-0 @(lang == "fa" ? "-right-[9px]" : "-left-[9px]") border-4 border-white dark:border-slate-800"></div>
                <div class="mb-2 flex items-center gap-2">
                    <span class="text-sm font-bold text-blue-600">@Loc.Get("Saturday", lang)، @Loc.Get("October25", lang)</span>
                    <span class="px-2 py-1 bg-green-50 text-green-600 rounded text-[10px] font-bold dark:bg-green-900/20">تکمیل شده</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white mb-4">ویزیت قلب و عروق - دکتر علی احمدی</h3>
                <div class="bg-slate-50 p-6 rounded-xl dark:bg-slate-900/50">
                    <h4 class="text-xs font-bold text-slate-400 mb-4 uppercase tracking-wider">نسخه الکترونیک</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-3 bg-white border border-slate-100 rounded-lg dark:bg-slate-800 dark:border-slate-700">
                            <div class="font-bold text-sm dark:text-slate-300">قرص آتورواستاتین ۲۰</div>
                            <div class="text-[10px] text-slate-400">روزانه یک عدد - شب‌ها</div>
                        </div>
                        <div class="p-3 bg-white border border-slate-100 rounded-lg dark:bg-slate-800 dark:border-slate-700">
                            <div class="font-bold text-sm dark:text-slate-300">کپسول امگا ۳</div>
                            <div class="text-[10px] text-slate-400">یک روز در میان</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative @(lang == "fa" ? "pr-8 border-r-2" : "pl-8 border-l-2") border-slate-100 dark:border-slate-700">
                <div class="absolute w-4 h-4 bg-slate-300 rounded-full top-0 @(lang == "fa" ? "-right-[9px]" : "-left-[9px]") border-4 border-white dark:border-slate-800"></div>
                <div class="mb-2 flex items-center gap-2">
                    <span class="text-sm font-bold text-slate-400">۱۰ شهریور ۱۴۰۲</span>
                </div>
                <h3 class="text-lg font-black text-slate-700 dark:text-slate-400">آزمایش خون دوره ای - آزمایشگاه مرکز</h3>
            </div>
        </div>
    </div>
</div>
