@page
@model dr24CoreNet.WebUI.Pages.Patient.HistoryModel
@{
    string lang = Request.Query["lang"].ToString() == "en" ? "en" : "fa";
    ViewData["Title"] = Loc.Get("HistoryTitle", lang);
}

<div class="max-w-5xl mx-auto px-4">
    <!-- Profile Header -->
    <div class="bg-royal-gradient p-12 rounded-[3rem] shadow-2xl mb-12 text-white relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-10">
            <div class="w-32 h-32 rounded-[32px] border-4 border-white/30 p-1 bg-white/10 backdrop-blur-md">
                <div class="w-full h-full bg-white rounded-[26px] flex items-center justify-center text-blue-700 text-4xl font-black">MS</div>
            </div>
            <div class="@(lang == "fa" ? "text-right" : "text-left") flex-grow">
                <h1 class="text-4xl font-black mb-2">مریم سادات</h1>
                <div class="flex gap-4 text-sm font-bold opacity-80 @(lang == "fa" ? "flex-row-reverse" : "flex-row")">
                    <span>کد ملی: ۰۱۲۳۴۵۶۷۸۹</span>
                    <span class="opacity-30">|</span>
                    <span>سن: ۲۸ سال</span>
                </div>
                <div class="mt-6 flex gap-3 @(lang == "fa" ? "flex-row-reverse" : "flex-row")">
                    <span class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-2xl text-xs font-black">گروه خونی: O+</span>
                    <span class="px-4 py-2 bg-emerald-400 text-emerald-950 rounded-2xl text-xs font-black uppercase tracking-widest">Active Record</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="space-y-10 relative">
        <!-- Vertical Line -->
        <div class="absolute top-0 bottom-0 @(lang == "fa" ? "right-8" : "left-8") w-1 bg-slate-200 dark:bg-slate-800 rounded-full"></div>

        @foreach (var apt in Model.Appointments)
        {
            <div class="relative @(lang == "fa" ? "pr-20" : "pl-20")">
                <!-- Timeline Dot -->
                <div class="absolute top-8 @(lang == "fa" ? "right-[26px]" : "left-[26px]") w-4 h-4 rounded-full border-4 border-white dark:border-slate-900 bg-blue-600 shadow-lg z-10"></div>

                <div class="card-colorful p-8 group">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                        <div class="@(lang == "fa" ? "text-right" : "text-left")">
                            <p class="text-xs font-black text-blue-600 uppercase tracking-widest mb-2">@apt.ReservedAt.ToString("yyyy/MM/dd")</p>
                            <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-1">Medical Consultation #@apt.Id</h3>
                            <p class="text-sm font-bold text-slate-500">Doctor ID: @apt.TimeSlot?.DoctorId</p>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="px-4 py-2 bg-slate-50 text-slate-600 rounded-xl text-[10px] font-black uppercase dark:bg-slate-900 dark:text-slate-400">Completed</span>
                            <button class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all dark:bg-slate-800">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
