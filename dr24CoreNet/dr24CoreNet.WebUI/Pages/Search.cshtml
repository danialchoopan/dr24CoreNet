@page
@model dr24CoreNet.WebUI.Pages.SearchModel
@{
    ViewData["Title"] = "جستجوی پزشک";
}

<div class="main-content" style="margin-right: 0;">
    <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row gap-8">
            <!-- Filters -->
            <div class="w-full md:w-64">
                <div class="card p-4 sticky top-8">
                    <h2 class="font-bold mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                        فیلترهای پیشرفته
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label class="text-xs text-slate-500 mb-1 block">تخصص</label>
                            <select class="input-modern w-full text-sm">
                                <option>همه تخصص‌ها</option>
                                <option>قلب و عروق</option>
                                <option>مغز و اعصاب</option>
                                <option>پوست و مو</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-slate-500 mb-1 block">محدوده شهر</label>
                            <input type="text" placeholder="مثلاً تهران" class="input-modern w-full text-sm" />
                        </div>
                        <button class="btn-primary w-full text-sm">اعمال فیلتر</button>
                    </div>
                </div>
            </div>

            <!-- Results -->
            <div class="flex-grow">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-xl font-bold text-slate-900">لیست پزشکان متخصص</h1>
                    <span class="text-sm text-slate-500">۱۴ مورد یافت شد</span>
                </div>

                <div class="space-y-4" id="results">
                    @foreach(var doctor in new[] {
                        new { Name = "دکتر امیرعلی علوی", Spec = "متخصص قلب و عروق", Rating = "۴.۸", Experience = "۱۵ سال" },
                        new { Name = "دکتر مریم رضایی", Spec = "فوق تخصص مغز و اعصاب", Rating = "۴.۹", Experience = "۱۲ سال" },
                        new { Name = "دکتر سهراب سپهری", Spec = "متخصص داخلی", Rating = "۴.۵", Experience = "۲۰ سال" }
                    })
                    {
                        <div class="card p-5 hover:border-blue-300 transition-colors group">
                            <div class="flex gap-4">
                                <div class="w-20 h-20 bg-slate-100 rounded-xl flex items-center justify-center text-2xl font-bold text-slate-400 group-hover:bg-blue-50 group-hover:text-blue-500 transition-colors">
                                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                </div>
                                <div class="flex-grow">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h3 class="font-bold text-slate-900">@doctor.Name</h3>
                                            <p class="text-sm text-blue-600 font-bold">@doctor.Spec</p>
                                        </div>
                                        <div class="flex items-center gap-1 bg-yellow-50 px-2 py-1 rounded-lg">
                                            <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.707-1.84-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            <span class="text-xs font-bold text-yellow-700">@doctor.Rating</span>
                                        </div>
                                    </div>

                                    <div class="mt-4 flex items-center justify-between border-t pt-4">
                                        <div class="flex gap-6 text-xs text-slate-500">
                                            <span class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                اولین نوبت: فردا ۸:۳۰
                                            </span>
                                            <span class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                                @doctor.Experience تجربه
                                            </span>
                                        </div>
                                        <a href="/Doctor/1" class="btn-primary text-xs py-2">رزرو نوبت</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
